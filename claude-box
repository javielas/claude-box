#!/usr/bin/env bash
# claude-box: run Claude Code in an isolated Podman container, with the
# folders it may access listed in a session file.
#
# Usage: claude-box <session>
#   <session>   path to a session file, or just its name: "santanna" means
#               ~/claude-box/sessions/santanna.conf
#
# Session file format, one folder per line (# starts a comment):
#   work  ~/Documents/Scripts        # required, exactly one: always rw, at /work
#   data  ~/Documents/Measurements   # optional: ro by default, at /work/data
#   repo  ~/code/some-lib       ro   # optional, any number: ro by default,
#   repo  ~/code/other-lib      rw   #   mounted at /repos/<folder-name>
#
# Claude's temp/scratchpad folder (/tmp/claude-<uid> in the container) is kept
# on the host in ~/claude-box/tmp/<session>/, so its files survive the session.
#
# Every read-write folder that is a git repo is pulled before the session and
# offered a commit and push after it.

set -euo pipefail

SESSIONS_DIR="$HOME/claude-box/sessions"
TMP_ROOT="$HOME/claude-box/tmp"

if [[ $# -lt 1 ]]; then
  echo "Usage: claude-box <session>" >&2
  echo "Available sessions:" >&2
  ls "$SESSIONS_DIR"/*.conf 2>/dev/null | xargs -rn1 basename | sed 's/\.conf$/  /' >&2
  exit 1
fi

# Accept either a path or a session name
if [[ -f $1 ]]; then
  conf=$(realpath "$1")
elif [[ -f "$SESSIONS_DIR/$1.conf" ]]; then
  conf="$SESSIONS_DIR/$1.conf"
else
  echo "Session not found: $1 (looked for a file and for $SESSIONS_DIR/$1.conf)" >&2
  exit 1
fi
name=$(basename "$conf" .conf)

work=""
mounts=()      # podman -v arguments
sync_dirs=()   # read-write folders to pull/commit/push

while read -r kind path mode _; do
  [[ -z ${kind:-} || $kind == \#* ]] && continue
  [[ ${mode:-} == \#* ]] && mode=""
  path="${path/#\~/$HOME}"
  if [[ ! -d $path ]]; then
    if [[ $kind == work ]]; then
      echo "Work folder not found: $path" >&2; exit 1
    fi
    echo "⚠ Folder not found, skipping: $path" >&2
    continue
  fi
  path=$(realpath "$path")

  case $kind in
    work)
      [[ -n $work ]] && { echo "Only one 'work' line is allowed in $conf" >&2; exit 1; }
      work=$path
      mounts+=(-v "$path":/work:Z)
      sync_dirs+=("$path")
      echo "work  $path → /work (rw)"
      ;;
    data)
      mode=${mode:-ro}
      if [[ $mode == rw ]]; then
        mounts+=(-v "$path":/work/data:Z); sync_dirs+=("$path")
      else
        mounts+=(-v "$path":/work/data:ro,Z)
      fi
      echo "data  $path → /work/data ($mode)"
      ;;
    repo)
      mode=${mode:-ro}
      target="/repos/$(basename "$path")"
      # lowercase z: shared SELinux label, so several sessions can mount the same repo
      if [[ $mode == rw ]]; then
        mounts+=(-v "$path":"$target":z); sync_dirs+=("$path")
      else
        mounts+=(-v "$path":"$target":ro,z)
      fi
      echo "repo  $path → $target ($mode)"
      ;;
    *)
      echo "Unknown line type '$kind' in $conf (use work, data or repo)" >&2; exit 1
      ;;
  esac
done < "$conf"

[[ -n $work ]] || { echo "No 'work' folder in $conf" >&2; exit 1; }

# --- Persistent Claude temp/scratchpad folder ---
# With --userns=keep-id the container user has the same uid as you,
# so Claude Code writes its temp files to /tmp/claude-<your uid>.
uid=$(id -u)
scratch="$TMP_ROOT/$name"
mkdir -p "$scratch"
mounts+=(-v "$scratch":/tmp/claude-"$uid":Z)
echo "tmp   $scratch → /tmp/claude-$uid (rw)"

args=(
  -it --rm
  --name "claude-$name"
  --userns=keep-id
  "${mounts[@]}"
  -v claude-home:/home/dev:U
  -e UV_PROJECT_ENVIRONMENT="/home/dev/venvs/$name"
  -e DATA_DIR=/work/data
)

# --- git helpers ---
is_repo()    { git -C "$1" rev-parse --git-dir >/dev/null 2>&1; }
has_remote() { is_repo "$1" && [[ -n $(git -C "$1" remote) ]]; }

git_start() {
  local dir=$1
  has_remote "$dir" || return 0
  echo "Pulling latest changes in $(basename "$dir")..."
  git -C "$dir" pull --rebase --autostash \
    || echo "⚠ Pull failed in $dir, check 'git status' before working."
}

git_end() {
  local dir=$1 ans msg
  is_repo "$dir" || return 0
  if [[ -n $(git -C "$dir" status --porcelain) ]]; then
    echo
    echo "=== Changes in $(basename "$dir") ==="
    git -C "$dir" status --short
    read -rp "Commit these changes? [Y/n] " ans
    if [[ ${ans:-Y} =~ ^[Yy]$ ]]; then
      read -rp "Message (Enter for default): " msg
      git -C "$dir" add -A
      git -C "$dir" commit -m "${msg:-Session $(date '+%Y-%m-%d %H:%M') on $(hostname)}" || true
      if has_remote "$dir"; then
        git -C "$dir" push || echo "⚠ Push failed in $dir, run 'git push' manually."
      fi
    fi
  elif has_remote "$dir" && [[ -n $(git -C "$dir" log '@{u}..' 2>/dev/null) ]]; then
    read -rp "$(basename "$dir") has unpushed commits. Push now? [Y/n] " ans
    [[ ${ans:-Y} =~ ^[Yy]$ ]] && { git -C "$dir" push || echo "⚠ Push failed."; }
  fi
}

# --- Load SSH key into the agent if it isn't there yet (asks passphrase once) ---
set +e
ssh-add -l >/dev/null 2>&1
agent_status=$?
set -e
if [[ $agent_status -eq 1 ]]; then
  ssh-add ~/.ssh/id_ed25519 || true
fi

# --- Start of session ---
for d in "${sync_dirs[@]}"; do git_start "$d"; done

# --- What runs inside the container ---
# 1. sync the Python environment, 2. start Claude,
# 3. when Claude exits, leave a shell open (type 'exit' to end the session).
inner='
[ -f pyproject.toml ] && uv sync
claude
echo
echo "Claude exited. Type exit to end the session (this offers to commit/push)."
exec bash
'

echo "Starting container claude-$name..."
podman run "${args[@]}" claude-box bash -c "$inner" || true

echo "Claude temp files for this session are in: $scratch"

# --- End of session ---
for d in "${sync_dirs[@]}"; do git_end "$d"; done
